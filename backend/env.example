# ========================================================
# QrParky Production Environment Configuration (.env)
# Domain: https://qrparky.site
# ========================================================

PORT=5000
NODE_ENV=production

# Database Configuration (MySQL on Bluehost Server)
DB_HOST=localhost
DB_PORT=3306
DB_USER=qrparky_user
DB_PASSWORD=YourStrongDatabasePasswordHere
DB_NAME=qr_parky_db

# Security & JWT Authentication Secrets (32+ chars random string)
JWT_SECRET=super_secret_jwt_key_qrparky_production_32chars!
JWT_EXPIRES_IN=10d
REFRESH_TOKEN_SECRET=super_secret_refresh_jwt_key_qrparky_production_32chars!
REFRESH_TOKEN_EXPIRES_IN=7d

# Cryptographic Key for AES-256-GCM QR Payload (Must be 32 bytes or 64 hex characters)
QR_ENCRYPTION_SECRET=bed857e5e9653ba50de4bf577ca7a7684a4e90d291326d8cfb992f68a4e2a672

# Razorpay Configuration (Sandbox or Production)
RAZORPAY_KEY_ID=rzp_test_TX9G3UI1BflzE4
RAZORPAY_KEY_SECRET=kPZcA0e7MKiDJS5iJW365CyX
RAZORPAY_WEBHOOK_SECRET=mockWebhookSecret12345
ENABLE_MOCK_PAYMENTS=false

# Production Domain URLs & CORS
CORS_ORIGIN=https://qrparky.site
FRONTEND_URL=https://qrparky.site

# SMTP Email Dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="QrParky Support <no-reply@qrparky.site>"
